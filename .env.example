# Portfolio Watch frontend — copy to .env (see docs/environment.md)

# Express API (required for full stack locally)
VITE_API_BASE_URL=http://localhost:3333

# Config profile: development | production (see src/config/config.js)
VITE_APP_ENV=development

# Legacy GraphQL endpoint field in config (optional)
# VITE_APP_BASE_URL=

# Firebase Analytics (optional)
# VITE_FIREBASE_MEASUREMENT_ID=

# Public upload template URLs (optional overrides)
# VITE_DEBT_SCHEDULE_TEMPLATE_URL=
# VITE_PFS_TEMPLATE_URL=
# VITE_PFS_TEMPLATE_XLSX_URL=

# Show Bootstrap breakpoint debug overlay in AppWrapper
VITE_DEV_IS_BREAKPOINT_VISABLE=false
